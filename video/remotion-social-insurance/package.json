{
  "name": "remotion-social-insurance",
  "version": "0.1.0",
  "private": true,
  "description": "制度の翻訳室のRemotion動画制作プロジェクト",
  "scripts": {
    "premium:assets": "node scripts/generate-premium-assets.mjs",
    "premium:check": "node scripts/verify-premium-model.mjs",
    "render:premium": "remotion render src/index.ts PremiumSupplement out/premium-supplement-2026.mp4 --concurrency=2",
    "preview:narrated-intro": "node scripts/narration-preview-server.cjs",
    "render:narrated-intro": "remotion render src/index.ts NarratedIntro out/intro-narrated-v1.mp4 --concurrency=2",
    "preview:intro": "remotion studio src/index.ts",
    "render:intro": "remotion render src/index.ts IntroPreview out/intro-preview.mp4 --scale=0.6666667 --concurrency=2",
    "studio": "remotion studio src/index.ts",
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SocialInsuranceOverview out/social-insurance-overview.mp4",
    "render:still": "remotion still src/index.ts SocialInsuranceOverview out/social-insurance-overview.png --frame=180",
    "transcribe": "node scripts/transcribe-audio.mjs",
    "transcribe:m4a": "powershell -ExecutionPolicy Bypass -File scripts/transcribe-audio.ps1"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@remotion/cli": "4.0.523",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
