{
  "durationSeconds":78,
  "sections":[{"start":0,"id":"overview"},{"start":13.71,"id":"medical"},{"start":27.59,"id":"pension"},{"start":43.7,"id":"care"},{"start":50.71,"id":"labor"},{"start":57.05,"id":"employment"},{"start":61.75,"id":"accident"},{"start":69.35,"id":"count"}],
  "cues":[
    {"start":0.59,"end":3.55,"text":"では、どんな社会保険があるのでしょうか。"},
    {"start":3.87,"end":10.21,"text":"今回は、医療・年金・介護・労働の"},
    {"start":10.21,"end":13.41,"text":"4つにまとめて見ていきます。"},
    {"start":13.71,"end":15.49,"text":"まず、医療保険。"},
    {"start":15.71,"end":18.2,"text":"けがや病気で治療を受けるとき、"},
    {"start":18.2,"end":21.1,"text":"医療費などを支える仕組みです。"},
    {"start":23.15,"end":26.9,"text":"会社員の健康保険は、この医療の一つです。"},
    {"start":27.59,"end":29.57,"text":"次に、年金保険。"},
    {"start":29.57,"end":33.09,"text":"老後の年金というイメージが強いかもしれませんが、"},
    {"start":33.29,"end":35.13,"text":"それだけでもありません。"},
    {"start":35.13,"end":37.33,"text":"一定の障害が残ったときは、"},
    {"start":37.45,"end":43.2,"text":"亡くなった方の遺族の生活を支える役割もあります。"},
    {"start":43.7,"end":45.2,"text":"そして、介護保険。"},
    {"start":45.2,"end":47.15,"text":"介護が必要になったとき、条件に応じて、"},
    {"start":47.15,"end":50.41,"text":"介護サービスなどを利用するための仕組みです。"},
    {"start":50.71,"end":52.57,"text":"最後が、労働保険。"},
    {"start":52.57,"end":56.2,"text":"これは、雇用保険と労災保険をまとめた呼び方です。"},
    {"start":57.05,"end":59.85,"text":"雇用保険は、失業したときの生活や、"},
    {"start":59.85,"end":61.6,"text":"再就職などを支えます。"},
    {"start":62.03,"end":65.53,"text":"労災保険は、仕事や通勤が原因の"},
    {"start":65.73,"end":68.6,"text":"けがや病気などに備えるものです。"},
    {"start":69.35,"end":71.57,"text":"つまり、雇用保険と労災保険を"},
    {"start":71.79,"end":73.99,"text":"別々に数えれば5つ。"},
    {"start":73.99,"end":77.9,"text":"今回は、この2つを労働保険としてまとめています。"}
  ]
}
