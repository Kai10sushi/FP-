  "coverage": {
    "durationSeconds": 44.1,
    "cues": [
      {
        "start": 0.4,
        "end": 4.35,
        "text": "二つ目は、暮らしのさまざまな場面に保障があることです。"
      },
      {
        "start": 5.48,
        "end": 7.06,
        "text": "社会保険というと、"
      },
      {
        "start": 7.06,
        "end": 10.7,
        "text": "病院で使う健康保険を思い浮かべるかもしれません。"
      },
      {
        "start": 11.5,
        "end": 13.3,
        "text": "でも、先ほど見たように、"
      },
      {
        "start": 13.3,
        "end": 18.5,
        "text": "老後や障害、介護、失業など、支える場面は広がっています。"
      },
      {
        "start": 19.3,
        "end": 20.9,
        "text": "ここで大切なのは、"
      },
      {
        "start": 20.9,
        "end": 24.1,
        "text": "制度の名前を全部暗記することではありません。"
      },
      {
        "start": 24.86,
        "end": 30.06,
        "text": "この困りごとにも関係する制度があるかもしれない、と気づけることです。"
      },
      {
        "start": 30.96,
        "end": 34.9,
        "text": "ただし、誰もが同じ保障を受けられるわけではありません。"
      },
      {
        "start": 35.8,
        "end": 37.6,
        "text": "働き方や年齢、"
      },
      {
        "start": 37.6,
        "end": 40.74,
        "text": "加入している制度などによって違うので、"
      },
      {
        "start": 40.74,
        "end": 43.98,
        "text": "自分の場合を確認する必要があります。"
      }
    ],
