{
  "risk": {
    "durationSeconds": 46.8,
    "cues": [
      {
        "start": 0.55,
        "end": 4.35,
        "text": "社会保険のメリットを、3つに分けて考えてみましょう。"
      },
      {
        "start": 5.33,
        "end": 9.2,
        "text": "一つ目は、大きな負担も一人だけで抱え込まないことです。"
      },
      {
        "start": 9.99,
        "end": 12.45,
        "text": "もちろん、貯蓄は大切です。"
      },
      {
        "start": 13.13,
        "end": 14.79,
        "text": "ただ、病気やけがは、"
      },
      {
        "start": 14.79,
        "end": 18.65,
        "text": "十分に貯金ができるまで待ってくれるわけではありません。"
      },
      {
        "start": 19.17,
        "end": 23.75,
        "text": "そこで、いつ誰に起きるかわからない負担に、みんなで備えます。"
      },
      {
        "start": 24.43,
        "end": 27.07,
        "text": "こうした考え方が、リスク分散です。"
      },
      {
        "start": 28.15,
        "end": 30.85,
        "text": "自分が今すぐ給付を受けていなくても、"
      },
      {
        "start": 31.15,
        "end": 34.15,
        "text": "必要なときに支えにつながる仕組みに参加している、"
      },
      {
        "start": 34.15,
        "end": 36.35,
        "text": "と考えるとわかりやすいですね。"
      },
      {
        "start": 36.96,
        "end": 40.5,
        "text": "ただし、損失がすべて埋まるわけではありません。"
      },
      {
        "start": 40.9,
        "end": 43.06,
        "text": "社会保険と自分の備え、"
      },
      {
        "start": 43.06,
        "end": 46.6,
        "text": "その両方で暮らしを守っていくことが大切です。"
      }
    ],
    "sections": [
      {
        "start": 0,
